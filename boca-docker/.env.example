# Copie este arquivo para .env e preencha nesta maquina.
# O .env nao entra no git. Use senhas novas antes do ensaio da SEMINFO.

BOCA_DB_HOST=boca-db
BOCA_DB_USER=bocauser
BOCA_DB_NAME=bocadb
BOCA_DB_SUPER_USER=postgres

# Segredo sempre entre aspas simples. Sem aspas, $nome e " #" mudam o valor
# no Compose. Aspas duplas tambem interpolam $. Nao use aspas simples dentro
# do segredo: o Compose fecha a citacao ali.
# BOCA_DB_PASSWORD e a senha do usuario bocauser. O padrao da imagem e o
# valor historico do upstream. So troque se o init do banco for refeito junto.
BOCA_DB_PASSWORD=''
BOCA_DB_SUPER_PASSWORD=''
POSTGRES_PASSWORD=''
BOCA_PASSWORD=''
BOCA_KEY=''
BOCA_JAIL_HOST=localhost

GF_SECURITY_ADMIN_USER=''
GF_SECURITY_ADMIN_PASSWORD=''

# Usuarios aplicados por boca_deploy profiles. Um login de equipe, nao tres.
# Senhas entre aspas simples, pela mesma regra dos segredos acima.
BOCA_CONTEST_USER='CCASuperControlContest'
BOCA_CONTEST_PASSWORD=''
BOCA_ADMIN_USER='CCASuperControlRuntime'
BOCA_ADMIN_PASSWORD=''
